{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "alchemy.run.ts",
    "src/shared",
    "src/cli",
    "src/local",
    "src/e2e",
    "src/smoke",
    "playwright.config.ts",
    "oxlint.config.ts",
    "oxlint.effect.ts",
    "video",
    "oxfmt.config.ts"
  ]
}
