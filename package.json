{
  "name": "ccal",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "bin": {
    "ccal": "src/cli/index.ts"
  },
  "workspaces": [
    "src/ui",
    "src/shared"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run build && CCAL_HOSTNAME=localhost alchemy dev",
    "build": "bun --filter ui build",
    "test:e2e": "playwright test",
    "test:smoke": "bun --bun playwright test -c tests/smoke/playwright.config.ts",
    "lint": "bun --bun oxlint . && ts-lint-effect && ts-lint-effect --project src/ui/tsconfig.app.json",
    "typecheck": "tsc --noEmit && tsc -b src/ui",
    "plan": "bun run deploy plan",
    "deploy": "bun src/deploy/deploy.ts",
    "lint:fix": "bun --bun oxlint . --fix",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@ccal/shared": "workspace:*",
    "@effect/platform-bun": "4.1.3",
    "@effect/sql-d1": "4.1.3",
    "alchemy": "2.0.0-beta.85",
    "cmail-client": "github:laroccacharly/cmail-client#v0.2.0",
    "effect": "4.1.3",
    "effect-lib": "github:laroccacharly/effect-lib#v0.37.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@effect/tsgo": "^0.51.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop#c44ef22ca116d0ba62a3ff663a0bd13a3f3fa40b",
    "oxlint-tsgolint": "^7.0.2003",
    "ts-lint": "github:laroccacharly/ts-lint#v0.6.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.2"
  },
  "overrides": {
    "@oxlint/plugins": "$oxlint"
  }
}
