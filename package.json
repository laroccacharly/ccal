{
  "name": "ccal",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "bin": {
    "ccal": "src/cli/index.ts"
  },
  "workspaces": [
    "src/ui",
    "src/shared"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run build && CCAL_HOSTNAME=localhost alchemy dev",
    "build": "bun --filter ui build",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c tests/smoke/playwright.config.ts",
    "lint": "bun --bun oxlint .",
    "plan": "alchemy plan",
    "deploy": "bun run build && alchemy deploy --yes",
    "lint:fix": "bun --bun oxlint . --fix",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@ccal/shared": "workspace:*",
    "@effect/platform-bun": "^4.0.0",
    "@effect/platform-node": "^4.0.0",
    "@effect/sql-d1": "^4.0.0",
    "alchemy": "2.0.0-beta.80",
    "cmail-client": "github:laroccacharly/cmail-client#v0.1.2",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop#c44ef22ca116d0ba62a3ff663a0bd13a3f3fa40b",
    "oxlint-tsgolint": "^7.0.2003",
    "ultracite": "^7.12.2"
  },
  "overrides": {
    "@oxlint/plugins": "$oxlint"
  }
}
